# ことばの切り替え。ゲームの中の日本語をそのまま「見出し」にして、英語のときはこの辞書の英語を出す。
# 文章を直すときは、日本語（main.gd / book.gd）と、ここの英語を両方直す。辞書にない文はそのまま日本語で出る。
# 英語のくまは、ていねいな英国紳士ふうのしゃべり方。

static var lang := "ja"  # "ja" / "en"


static func t(s: String) -> String:
	if lang == "ja":
		return s
	s = s.replace("\r", "")
	if EN.has(s):
		return EN[s]
	if s.ends_with("★") and EN.has(s.trim_suffix("★")):  # 隠し味つきの料理名
		return EN[s.trim_suffix("★")] + "★"
	return s


